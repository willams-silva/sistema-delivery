RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^categoria-sabores-(.*)$ pizza.php?url=$1&sabores=$1 [L]
RewriteRule ^categoria-(.*)$ itens.php?url=$1 [L]
RewriteRule ^adicionais-(.*)$ adicionais.php?url=$1&item=$1&sabores=$1 [L]
RewriteRule ^observacoes-(.*)$ observacoes.php?url=$1&item=$1&sabores=$1 [L]
RewriteRule ^carrinho(.*)$ carrinho.php [L]
RewriteRule ^finalizar(.*)$ finalizar.php [L]
RewriteRule ^index(.*)$ index.php [L]
RewriteRule ^index.php(.*)$ index.php [L]
RewriteRule ^pedido/(.*)$ pedido.php?id=$1 [L]
RewriteRule ^mesa/(.*)$ mesa.php?id_mesa=$1 [L]

RewriteRule ^site/(.*)$ site.php?url=$1 [L]


RewriteRule ^pagamento_plano_asaas/(.*)$ sistema/sas/asaas/index.php?id_conta=$1 [L]
RewriteRule ^pagamento_plano/(.*)$ sistema/sas/pagamentos/index.php?id_conta=$1 [L]
RewriteRule ^pagamento/(.*)$ sistema/sas/pagamentos/index.php?id_conta=$1 [L]